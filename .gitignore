# Nix build outputs
result
result-*

# direnv
.direnv/

# JetBrains IDE state
.idea/

# Editor/OS noise
*.swp
*~
.DS_Store

# Never commit private key material or decrypted secrets.
# (sops-encrypted files under secrets/ ARE safe to commit.)
*.age
keys.txt
*.dec

# Scratch directory for raw key material (data/rsa_key.pem). Nothing in the
# flake reads from here, so it is local-only — unlike secrets/, which is
# sops-encrypted and tracked.
data/

